#!/bin/bash
# Keep Xvnc alive even if the XFCE session exits. TurboVNC's vncserver
# wrapper kills Xvnc when this script returns, so we spawn XFCE in the
# background and block forever — any session-level hiccup (user systemd,
# DBus activation) no longer tears down the VNC server.
xsetroot -solid "#222222" 2>/dev/null || true
eval "$(dbus-launch --sh-syntax)" 2>/dev/null || true
vglrun startxfce4 &
exec sleep infinity
