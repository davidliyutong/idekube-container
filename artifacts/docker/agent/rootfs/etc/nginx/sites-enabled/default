server {
    listen 80;
    listen [::]:80;

    # openclaw agent gateway (HTTP UI + WebSocket).
    # Preserve-prefix proxy: openclaw is configured with
    # gateway.controlUi.basePath=/agent, so it serves both the HTML and
    # its WebSocket endpoint under /agent (the UI bundle derives the WS
    # URL from window.location.pathname). The prefix-match location
    # below covers both the bare `/agent` (WS upgrade target) and
    # `/agent/...` (HTML, assets, REST). nginx forwards the URI as-is
    # because the proxy_pass URL has no path component.
    location /agent {
        proxy_pass http://127.0.0.1:18789;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_read_timeout 86400;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        add_header Strict-Transport-Security "max-age=15552000; includeSubDomains" always;
        client_max_body_size 0;
    }

    # SSH via Websocat
    location = /ssh {
        proxy_pass http://127.0.0.1:2222/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400;
        client_max_body_size 0;
    }
    location = /ssh/ {
        proxy_pass http://127.0.0.1:2222/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400;
        client_max_body_size 0;
    }

    # Landing page
    location = / {
        root /usr/share/nginx/html;
        index index.html;
    }

}
